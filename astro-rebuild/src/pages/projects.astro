---
import Layout from "../layouts/Layout.astro";
import { getCollection } from 'astro:content';
const projects = await getCollection('project');

layout: Layout
title: "Projects"
---
<Layout>
<div id="project-filter">
    <ul>
        Filter by: 
        <li><a href="" data-type="independent">Code On GitHub/Independent Project</a></li>
        <li><a href="" data-type="job-vail-systems">Vail Systems</a></li>
        <li><a href="" data-type="academic">CME Group</a></li>
        </ul>
</div>
    {projects.map(project => (
    <div class="project" data-type={project.data.type}>
        {project.data.type != "independent" && <span class="job-project-chip">Part Of: <a href={`/work-experience#${project.data.type}`}>{project.data.type}</a></span>}
        <h4>{project.data.title}</h4>
        <p class="tagline">{project.data.subtitle}</p>
        <h5>Languages & Tools</h5>
        <ul>
            {project.data.technologiesUsed?.map((item: string) => (
                <li>{item}</li>
            ))}
        </ul>
        {project.body &&
        <>
        <h5>Project Specifics</h5>
        <ul>
            {project.body}
        </ul>
        </>}

         <div class="button-container">
            <ul>
        {project.data.screenshots &&<li><a class="button" href="{{project.data.screenshots}}">View Screenshots</a></li>}
        {project.data.codeLink &&<li><a class="button" href="{{project.data.codeLink}}">View on GitHub</a></li>}
        </ul>
        </div>
            {projects.length === 0 && <li>No posts found.</li>}

    </div>
)
)
}
</Layout>