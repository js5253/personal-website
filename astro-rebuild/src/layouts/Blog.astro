        <p>No Comments Found.</p>
        <form class="commentBox" method="/comment">
            <h3>Add a comment</h3>
            <textarea type="text" name="comment" id="commentBox"></textarea>
            <label for="megatrons">How many r's are in <b>strawberrerry</b>?</label>
            <input type="text" name="megatrons" id="megatrons" />
            <input type="submit" value="Submit" id="submitButton" />

        </form>
    </div> -->
    </div>
        <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
        <script is:inline src="/js/darkMode.js"></script>
        <script is:inline src="/js/comments.js"></script>
</body>
</html>