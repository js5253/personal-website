---
import Header from "../components/Header.astro";
import NavBar from "../components/NavBar.astro";
---

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jose Sanchez</title>
    <link rel="stylesheet" href="/css/reset.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- prefetch all pages -->
    <link rel="prefetch" href="/portfolio" as="document" />
    <link rel="prefetch" href="/work-experience" as="document" />
    <link rel="prefetch" href="/projects" as="document" />
</head>

<body>
    <Header />
    <NavBar />
    <canvas width="1400px" height="1400px" id="falling-text"></canvas>
    <script>
        const text = ["RUST", "HTML", "REACT"];
        const canvas = document.getElementById("falling-text");
        const ctx = canvas.getContext("2d");

        let startTime = null;
        // util
        const clamp = (val, min, max) => Math.min(Math.max(val, min), max);


        // end util
        const animate = (timestamp) => {
            console.log("Running animate!")
            if (!startTime) startTime = timestamp;
            const progress = timestamp - startTime;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            text.forEach((text, idx) => {
                let y = clamp((idx + 1) * timestamp, 0, 1000)

                ctx.fillText(text, idx * 200, y, 300)
            });

            requestAnimationFrame(animate);
        };
        function fillRemainingHeight() {
            const elementTop = canvas.getBoundingClientRect().top;

            const bottomMargin = 20;

            const calculatedHeight = window.innerHeight - elementTop - bottomMargin;

            // canvas.height = Math.max(0, calculatedHeight) + 'px';
            // canvas.width = window.innerWidth + "px"
        }
        fillRemainingHeight();
        window.addEventListener("resize", fillRemainingHeight);

        ctx.font = "48px serif";

        text.forEach((text, idx) => {
            ctx.fillText(text, (idx + 1) * 100, (idx + 1) * 100);
        });
        requestAnimationFrame(animate);
        //   ctx.fillText("Hello world", 10, 50);
    </script>
    <script is:inline src="/js/darkMode.js"></script>
</body>

</html>