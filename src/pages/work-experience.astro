---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
title: "Work Experience"
const experiences = await getCollection('workExperience');
---
<Layout title="Work Experience">
{experiences.map(experience => (
<div class="job" id={experience.id}>
    <h4>{experience.data.title}</h4>
    {experience.data.subtitle && <h5>{experience.data.subtitle}</h5>}
    <ul set:html={experience.body}>
        
    </ul>
</div>

))}
</Layout>